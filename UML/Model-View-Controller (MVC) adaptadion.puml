@startuml MVC_Adaptation
!theme plain
skinparam backgroundColor White
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false

title Risk Index Calculator - Адаптація MVC

actor "Користувач" as User

package "View\nReact + Tailwind CSS" as View {
  component "App.jsx" as App
  package "layout" {
    component "AppLayout" as AppLayout
    component "AppHeader" as AppHeader
    component "DashboardGrid" as DashboardGrid
  }
  package "risk" {
    component "RiskDashboardOverview" as Overview
    component "RiskFactorInput" as RiskInput
    component "RiskSummaryCard" as Summary
  }
  package "charts\nRecharts" {
    component "RiskChartPanel" as ChartPanel
    component "BarChart" as BarChart
    component "RadarChart" as RadarChart
    component "PieChart" as PieChart
  }
  package "ui" {
    component "SegmentedTabs" as Tabs
    component "DashboardStatCard" as StatCard
  }
}

package "Controller / ViewModel\nReact Hooks" as Controller {
  component "useRiskDashboard" as DashboardHook
  component "useRiskFactorWizard" as WizardHook
  component "Store actions" as StoreActions
  component "Selectors" as Selectors
}

package "Model\nState + Domain Services" as Model {
  component "useRiskStore\nZustand + persist" as Store
  component "RiskCalculationService" as CalcService
  component "riskFactors service" as FactorService
  database "localStorage" as LocalStorage
}

User --> App : взаємодія з інтерфейсом

App --> AppLayout : композиція сторінки
AppLayout --> AppHeader
AppLayout --> DashboardGrid
DashboardGrid --> Overview
DashboardGrid --> RiskInput
DashboardGrid --> Summary
App --> ChartPanel
App --> Tabs
Overview --> StatCard
ChartPanel --> BarChart
ChartPanel --> RadarChart
ChartPanel --> PieChart

App --> DashboardHook : отримує стан екрана
RiskInput --> WizardHook : керує майстром оцінки
DashboardHook --> Selectors : читає похідні дані
WizardHook --> Selectors : читає поточний крок
DashboardHook --> StoreActions : запуск розрахунку / скидання
WizardHook --> StoreActions : зміна факторів / навігація

Selectors --> Store : читання стану
StoreActions --> Store : оновлення стану
Store --> CalcService : обчислення індексу ризику
Store --> FactorService : межі кроків та фактори
Store --> LocalStorage : persist / hydrate
FactorService --> Store : метадані факторів

note right of View
  Відповідає тільки за відображення:
  - dashboard layout
  - форми оцінювання
  - картки результатів
  - Recharts-візуалізації
end note

note bottom of Controller
  Адаптує Model до View:
  - selectors
  - workflow hooks
  - обробка UI-подій
  - підготовка даних для компонентів
end note

note left of Model
  Містить стан і бізнес-правила:
  - Zustand store
  - localStorage persistence
  - розрахунок ризику
  - довідник факторів ризику
end note

@enduml