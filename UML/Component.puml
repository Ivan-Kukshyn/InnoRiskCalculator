@startuml RiskIndexCalculatorComponentDiagram

!theme plain
skinparam backgroundColor transparent
skinparam componentStyle rectangle
skinparam shadowing false

title Risk Index Calculator - Component Diagram

actor "Користувач" as User

package "Frontend" {

  [App.jsx] as App

  package "UI Components" {
    [Navbar] as Navbar
    [Sidebar] as Sidebar
    [RiskForm] as RiskForm
    [ResultCard] as ResultCard
    [RiskChart] as RiskChart
  }

  package "Charts" {
    [BarChart] as BarChart
    [RadarChart] as RadarChart
    [PieChart] as PieChart
  }

  package "Hooks" {
    [useRiskDashboard] as UseDashboard
  }

  package "State" {
    [useRiskStore] as Store
    [Zustand Persist] as Persist
  }

  package "Services" {
    [RiskCalculationService] as CalcService
    [riskFactors] as RiskFactors
  }

  database "localStorage" as LocalStorage
}

User --> App

App --> Navbar
App --> Sidebar
App --> RiskForm
App --> ResultCard
App --> RiskChart

RiskChart --> BarChart
RiskChart --> RadarChart
RiskChart --> PieChart

RiskForm --> UseDashboard
UseDashboard --> Store

Store --> CalcService
Store --> RiskFactors
Store --> Persist
Persist --> LocalStorage

note right of RiskChart
  Recharts visualization
  - Bar Chart
  - Radar Chart
  - Pie Chart
end note

note bottom of Store
  Zustand state:
  - factors
  - currentStep
  - history
  - riskResult
end note

@enduml