@startuml RiskCalculatorDeploymentDiagram

!theme plain
skinparam backgroundColor transparent
skinparam shadowing false

title Risk Index Calculator - Deployment Diagram

node "Developer PC" as Dev {
  artifact "Source Code\nReact + Vite" as Source
  artifact "package.json" as Package
}

node "Build System" as Build {
  artifact "npm install" as Install
  artifact "npm run build" as BuildCmd
  artifact "dist/" as Dist
}

cloud "Hosting" as Hosting {
  artifact "HTML / CSS / JS" as StaticFiles
}

node "User Device" as Device {

  node "Browser" as Browser {
    artifact "React SPA" as ReactApp
    artifact "Tailwind CSS UI" as TailwindUI
    artifact "Recharts" as Recharts
    database "localStorage" as LocalStorage
  }
}

node "Vite Dev Server\nlocalhost:5173" as DevServer

Source --> Install
Install --> BuildCmd
BuildCmd --> Dist
Dist --> Hosting

Device --> Hosting : HTTPS request
Hosting --> Browser : static files

Browser --> ReactApp
ReactApp --> TailwindUI
ReactApp --> Recharts
ReactApp --> LocalStorage

Source --> DevServer : npm run dev
DevServer --> Browser : hot reload

note right of Build
  Production build:
  - npm install
  - npm run build
  - deploy dist/
end note

note bottom of Browser
  SPA працює у браузері:
  - локальні розрахунки
  - Zustand persistence
  - localStorage storage
end note

@enduml